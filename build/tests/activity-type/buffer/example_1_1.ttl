<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer> ;
    rim:proposer gp:geolabs .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/buffer to https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer gp:geolabs .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer> a owl:Class,
        acttype:ActivityType ;
    dcterms:source [ dcterms:title "ISO/IEC 13249-3:2016 SQL multimedia and application packages -- Part 3: Spatial, §5.1.5 ST_Buffer" ],
        [ dcterms:references <https://www.ogc.org/standards/sfa/> ;
            dcterms:title "OGC 06-103r4 Simple Feature Access - Part 1: Common Architecture, §6.1.23" ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/buffer> ;
    skos:altLabel "ST_Buffer" ;
    skos:definition "Returns a geometric object representing all points whose distance from this geometric object is less than or equal to a given distance." ;
    skos:prefLabel "Buffer" ;
    acttype:associatedAgentType prov:SoftwareAgent ;
    acttype:generatedEntityType geo:Geometry ;
    acttype:usedEntityType geo:Geometry ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

