@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix gp: <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/family-2026-11-19> a rim:RegisterAction ;
    dcterms:description "The parent class (rdfs:subClassOf) changes from https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType to the family https://w3id.org/geolabs/ospd/generic-profiles/activity-type/band-algebra, itself a sub-class of it (decision of 2026-11-19: activity types grouped by meaning). The definition and the entity types are unchanged. Classified substantive, a change of parent class." ;
    prov:startedAtTime "2026-11-19T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rdfs:subClassOf ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/radiometric-index to https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/relations-2026-11-10> a rim:RegisterAction ;
    dcterms:description "The Relations text of this activity type now names the two Implementation Profiles that point to it with activityType, radiometric-index and radiometric-index-single-band (added 2026-11-10), instead of one. The definition, parent class and entity types are unchanged. Classified clarifying, a documentary text." ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index> a owl:Class,
        acttype:ActivityType ;
    dcterms:source [ dcterms:references <https://www.ogc.org/standards/wcps/> ;
            dcterms:title "OGC 08-068r2 Web Coverage Processing Service (WCPS) Language Interface Standard" ] ;
    rdfs:subClassOf <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/band-algebra> ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/radiometric-index> ;
    skos:definition "Computes one or more named radiometric indices (e.g. NDVI, NDWI, SAVI) from the relevant spectral channels of the input raster(s)." ;
    skos:prefLabel "Radiometric index" ;
    acttype:associatedAgentType prov:SoftwareAgent ;
    acttype:generatedEntityType geo:Feature ;
    acttype:usedEntityType geo:Feature ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/family-2026-11-19>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/identifier-2026-11-17>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index/actions/relations-2026-11-10> ;
    rim:inRegister gp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/activity-type/radiometric-index"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

