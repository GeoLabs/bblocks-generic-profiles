<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/family-2026-11-19> a rim:RegisterAction ;
    dcterms:description "The parent class (rdfs:subClassOf) changes from https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType to the family https://w3id.org/geolabs/ospd/generic-profiles/activity-type/spatial-model-conversion, itself a sub-class of it (decision of 2026-11-19: activity types grouped by meaning). The definition and the entity types are unchanged. Classified substantive, a change of parent class." ;
    prov:startedAtTime "2026-11-19T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rdfs:subClassOf ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/point-cloud-to-grid to https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid> a owl:Class,
        acttype:ActivityType ;
    rdfs:subClassOf <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/spatial-model-conversion> ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/point-cloud-to-grid> ;
    skos:definition "Writes one value per grid cell from the points falling in it -- by default the z value of the first point -- as a single-band raster." ;
    skos:prefLabel "Point cloud to grid" ;
    acttype:associatedAgentType prov:SoftwareAgent ;
    acttype:generatedEntityType geo:Feature ;
    acttype:usedEntityType geo:Feature ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/family-2026-11-19>,
        <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-to-grid"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

