@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix gp: <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-construction> a owl:Class,
        acttype:ActivityType ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Derives a new geometry from one input geometry and, possibly, parameters such as a distance." ;
    skos:prefLabel "Geometry construction" ;
    acttype:associatedAgentType prov:SoftwareAgent ;
    acttype:generatedEntityType geo:Geometry ;
    acttype:usedEntityType geo:Geometry ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-construction/actions/addition> ;
    rim:inRegister gp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-construction"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-construction/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-19T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-construction> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

