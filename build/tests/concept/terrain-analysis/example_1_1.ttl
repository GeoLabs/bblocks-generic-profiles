<https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/concept/terrain-analysis to https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer gp:geolabs .

<https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis> a gp:ProcessConcept ;
    dcterms:source [ dcterms:title "Wilson, J.P., Gallant, J.C. (2000): Terrain Analysis: Principles and Applications (cited by SAGA's Topographic Position Index tool)" ],
        [ dcterms:references <https://saga-gis.sourceforge.io/saga_tool_doc/7.3.0/index.html> ;
            dcterms:title "SAGA 7.3.0 tool libraries, category Terrain Analysis" ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/concept/terrain-analysis> ;
    skos:definition "Operations deriving terrain attributes from an elevation model: local surface derivatives (slope, aspect, curvature), neighbourhood indices (terrain ruggedness, topographic position) and illumination (hillshading) -- independent of any input/output signature or implementation (OGC 14-065 WPS 2.0.2 §7.5.1). A kind of raster coverage processing: an elevation model is a single-band raster whose values are elevations." ;
    skos:inScheme gp:concept ;
    skos:prefLabel "Terrain Analysis" ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/process-concept> ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/concept/terrain-analysis"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

