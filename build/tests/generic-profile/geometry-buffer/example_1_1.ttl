    proc:keywords "geometry" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer> a gp:GenericProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/geometry-buffer> ;
    skos:broader <https://w3id.org/geolabs/ospd/generic-profiles/concept/vector-geometry-processing> ;
    skos:definition "Computes a new geometry from one input geometry and a scalar distance. A different shape from binary-spatial-operation: one Geometry, one Number, not two Geometries." ;
    skos:inScheme gp:generic-profile ;
    skos:prefLabel "Geometry buffer" ;
    gp:inputs [ ns1:distance <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/inputs/distance> ;
            ns1:geometry <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/inputs/geometry> ] ;
    gp:outputs [ ns2:result <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/outputs/result> ] ;
    proc:keywords "buffer",
        "geometry",
        "spatial analysis",
        "vector" ;
    proc:metadata [ dcterms:title "Process Concept: Vector Geometry Processing" ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/generic-profile> ;
