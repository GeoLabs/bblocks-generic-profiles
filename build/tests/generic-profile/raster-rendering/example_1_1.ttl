<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/raster-rendering to https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/colourMap> dcterms:description "the colours given to the values of the raster" ;
    dcterms:title "Colour map" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/colour-map> ;
    proc:keywords "colour map" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/raster> dcterms:description "the raster to depict" ;
    dcterms:title "Raster" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    proc:keywords "raster" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/outputs/image> dcterms:description "the rendering of the raster" ;
    dcterms:title "Rendered image" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/rendered-image> ;
    proc:keywords "image" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering> a gp:GenericProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/raster-rendering> ;
    skos:broader <https://w3id.org/geolabs/ospd/generic-profiles/concept/raster-coverage-processing> ;
    skos:definition "Depicts a raster as an image for viewing, by giving each cell a colour from a colour map. One Raster and a colour map in, one rendered image out." ;
    skos:inScheme gp:generic-profile ;
    skos:prefLabel "Raster rendering" ;
    gp:inputs [ ns1:colourMap <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/colourMap> ;
            ns1:raster <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/raster> ] ;
    gp:outputs [ ns2:image <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/outputs/image> ] ;
    proc:keywords "colour map",
        "raster",
        "rendering" ;
    proc:metadata [ dcterms:title "Process Concept: Raster Coverage Processing" ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/generic-profile> ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

