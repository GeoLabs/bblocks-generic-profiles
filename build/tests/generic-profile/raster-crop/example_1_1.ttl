<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/raster-crop to https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer gp:geolabs .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/inputs/areaOfInterest> dcterms:description "the region of interest to crop to" ;
    dcterms:title "Bounding box" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/bounding-box> ;
    proc:keywords "bounding box" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/inputs/raster> dcterms:description "the input raster coverage" ;
    dcterms:title "Raster" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    proc:keywords "raster" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/outputs/raster> dcterms:description "the cropped raster coverage" ;
    dcterms:title "Raster" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    proc:keywords "raster" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop> a gp:GenericProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/raster-crop> ;
    skos:broader <https://w3id.org/geolabs/ospd/generic-profiles/concept/raster-coverage-processing> ;
    skos:definition "Crops a raster coverage to a region of interest. One Raster input, an area of interest, one Raster output covering only that area." ;
    skos:inScheme gp:generic-profile ;
    skos:prefLabel "Raster crop" ;
    gp:inputs [ ns2:areaOfInterest <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/inputs/areaOfInterest> ;
            ns2:raster <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/inputs/raster> ] ;
    gp:outputs [ ns1:raster <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/outputs/raster> ] ;
    proc:keywords "coverage",
        "crop",
        "raster" ;
    proc:metadata [ dcterms:title "Process Concept: Raster Coverage Processing" ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/actions/clarification-2026-11-06>,
        <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop/actions/identifier-2026-11-17> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/generic-profile> ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-crop"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

