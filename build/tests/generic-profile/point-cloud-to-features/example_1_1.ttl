<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/point-cloud-to-features to https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer gp:geolabs .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/inputs/points> dcterms:description "the input point cloud" ;
    dcterms:title "Point cloud" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud> ;
    proc:keywords "point cloud" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/outputs/result> dcterms:description "one feature per point, its attributes as feature attributes" ;
    dcterms:title "Feature collection" ;
    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/feature-collection> ;
    proc:keywords "feature collection" .

<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features> a gp:GenericProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/point-cloud-to-features> ;
    skos:broader <https://w3id.org/geolabs/ospd/generic-profiles/concept/point-cloud-processing> ;
    skos:definition "Converts a point cloud to a feature collection. One point cloud in, one feature collection out." ;
    skos:inScheme gp:generic-profile ;
    skos:prefLabel "Point cloud to features" ;
    gp:inputs [ ns1:points <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/inputs/points> ] ;
    gp:outputs [ ns2:result <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/outputs/result> ] ;
    proc:keywords "conversion",
        "feature collection",
        "point cloud" ;
    proc:metadata [ dcterms:title "Process Concept: Point Cloud Processing" ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-to-features/actions/identifier-2026-11-17> ;
