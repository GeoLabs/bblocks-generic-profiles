<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/unary-spatial-predicate/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/unary-spatial-predicate to https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/unary-spatial-predicate, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/unary-spatial-predicate/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType gp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/unary-spatial-predicate> ;
    rim:changeClassification rim:clarifyingChange ;
