<https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/unary-spatial-predicate> a gp:GenericProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/unary-spatial-predicate> ;
    skos:broader <https://w3id.org/geolabs/ospd/generic-profiles/concept/vector-geometry-processing> ;
    skos:definition "Tests a boolean property of a single geometry. One Geometry input, one Boolean output -- the one-input counterpart to `binary-spatial-predicate`'s two." ;
