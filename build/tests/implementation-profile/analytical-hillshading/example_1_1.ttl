<https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading> a gp:ImplementationProfile ;
    skos:definition "Implementation Profile of the operation Analytical hillshading, whose meaning is its activity type (activityType): the signature of the Generic Profile Analytical hillshading, bound to data exchange formats." ;
    skos:inScheme gp:implementation-profile ;
    skos:prefLabel "Analytical hillshading" ;
    gp:activityType <https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/analytical-hillshading> ;
    gp:inputs [ ns1:altitude <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/inputs/altitude> ;
            ns1:azimuth <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/inputs/azimuth> ;
            ns1:elevation <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/inputs/elevation> ] ;
    gp:outputs [ ns2:result <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/outputs/result> ] ;
    gp:refinesGenericProfile <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/analytical-hillshading> ;
    proc:keywords "Hillshade",
        "elevation",
        "hillshade",
        "illumination",
        "raster",
        "terrain" ;
    proc:metadata [ dcterms:title "Generic Profile: Analytical hillshading" ],
        [ dcterms:title "Process Concept: Terrain Analysis" ] ;
    rim:hasAction <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/actions/addition>,
        <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/actions/meaning-2026-11-09>,
        <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/actions/representation-2026-11-09>,
        <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/actions/sections-restored-2026-11-09>,
        <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading/actions/tools-2026-11-09> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/implementation-profile> ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/analytical-hillshading"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

