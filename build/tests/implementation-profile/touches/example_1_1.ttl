        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/actions/sections-restored-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/actions/tools-2026-11-09> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/implementation-profile> ;
