<https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches> a gp:ImplementationProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/touches> ;
    skos:definition "Implementation Profile of the operation Touches, whose meaning is its activity type (activityType): the signature of the Generic Profile Binary spatial predicate, bound to data exchange formats." ;
    skos:inScheme gp:implementation-profile ;
    skos:prefLabel "Touches" ;
    gp:activityType <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/touches> ;
    gp:inputs [ ns1:geometry1 <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/inputs/geometry1> ;
            ns1:geometry2 <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/inputs/geometry2> ] ;
    gp:outputs [ ns2:result <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/outputs/result> ] ;
    gp:refinesGenericProfile <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate> ;
    proc:keywords "Touches",
        "geometry",
        "predicate",
        "spatial relation",
        "vector" ;
    proc:metadata [ dcterms:title "Process Concept: Vector Geometry Processing" ],
        [ dcterms:title "Generic Profile: Binary spatial predicate" ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/touches/actions/identifier-2026-11-17>,
