        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/topographic-position-index/actions/representation-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/topographic-position-index/actions/sections-restored-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/topographic-position-index/actions/tools-2026-11-09> ;
    rim:inRegister gp:register ;
