<https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains> a gp:ImplementationProfile ;
    owl:sameAs <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/contains> ;
    skos:definition "Implementation Profile of the operation Contains, whose meaning is its activity type (activityType): the signature of the Generic Profile Binary spatial predicate, bound to data exchange formats." ;
    skos:inScheme gp:implementation-profile ;
    skos:prefLabel "Contains" ;
    gp:activityType <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/contains> ;
    gp:inputs [ ns2:geometry1 <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/inputs/geometry1> ;
            ns2:geometry2 <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/inputs/geometry2> ] ;
    gp:outputs [ ns1:result <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/outputs/result> ] ;
    gp:refinesGenericProfile <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate> ;
    proc:keywords "Contains",
        "geometry",
        "predicate",
        "spatial relation",
        "vector" ;
    proc:metadata [ dcterms:title "Process Concept: Vector Geometry Processing" ],
        [ dcterms:title "Generic Profile: Binary spatial predicate" ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/addition>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/identifier-2026-11-17>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/meaning-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/operation-sources-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/representation-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/sections-restored-2026-11-09>,
        <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains/actions/tools-2026-11-09> ;
    rim:inRegister gp:register ;
    rim:itemClass <https://w3id.org/geolabs/ospd/generic-profiles/item-class/implementation-profile> ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/contains"^^xsd:anyURI ;
