    skos:definition "Implementation Profile of the operation Point cloud thinning (simple), whose meaning is its activity type (activityType): the signature of the Generic Profile Point cloud thinning, bound to data exchange formats." ;
    skos:inScheme gp:implementation-profile ;
    skos:prefLabel "Point cloud thinning (simple)" ;
    gp:activityType <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/point-cloud-thinning> ;
