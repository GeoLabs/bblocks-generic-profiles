            ns1:points <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/point-cloud-thinning/inputs/points> ] ;
    gp:outputs [ ns2:result <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/point-cloud-thinning/outputs/result> ] ;
    gp:refinesGenericProfile <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/point-cloud-thinning> ;
    proc:keywords "point cloud",
        "thinning" ;
    proc:metadata [ dcterms:title "Process Concept: Point Cloud Processing" ],
        [ dcterms:title "Generic Profile: Point cloud thinning" ] ;
