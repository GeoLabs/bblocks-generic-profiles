<bblocks://generic-profiles.activity-type.otsu-thresholding> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Activity type: Otsu thresholding" ;
    dct:abstract "Divides the cells of a single-band raster into two classes at the threshold computed from the histogram of the cell values by Otsu's method, which maximises the variance between the two classes, and returns the cells of the upper class as a binary mask."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
