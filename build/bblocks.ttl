<bblocks://generic-profiles.activity-type.intersects> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Activity type: Intersects" ;
    dct:abstract "Returns TRUE if this geometric object spatially intersects anotherGeometry (i.e. they share at least one point). Equivalent to the negation of Disjoint."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
