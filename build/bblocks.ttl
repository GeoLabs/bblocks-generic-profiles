<bblocks://generic-profiles.concept.vector-geometry-processing> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Process Concept: Vector Geometry Processing" ;
    dct:abstract "General group covering operations on vector geometries: testing spatial relationships between two geometries, deriving a new geometry from one or two others, and measuring a geometry's own properties -- independent of any input/output signature or implementation (OGC 14-065 WPS 2.0.2 §7.5.1)."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-30T00:00:00+00:00"^^xsd:dateTime ;
