<bblocks://generic-profiles.concept.data-discovery-and-access> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Process Concept: Data Discovery and Access" ;
    dct:abstract "Operations that find data products in catalogues and retrieve their data: selecting products by area, time and metadata, and retrieving bands or areas of a product, without computing new quantities from them -- independent of any input/output signature or implementation (OGC 14-065 WPS 2.0.2 §7.5.1)."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
