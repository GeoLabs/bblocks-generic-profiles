<bblocks://generic-profiles.generic-profile.raster-thresholding> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Generic Profile: Raster thresholding" ;
    dct:abstract "Divides the cells of a single-band raster into two classes at a threshold that the operation determines from the raster's values, and returns the upper class as a binary mask. One single-band Raster input, one Binary mask output."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
