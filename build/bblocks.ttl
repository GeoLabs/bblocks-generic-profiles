        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Implementation Profile: Crosses" ;
    dct:abstract "Returns TRUE if this geometric object 'spatially crosses' anotherGeometry: the intersection results in a geometry of dimension one less than the maximum dimension of the two source geometries, and the intersection set is interior to both."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
