        <bblocks://generic-profiles.activity-type.slope>,
        <bblocks://generic-profiles.activity-type.symdifference>,
        <bblocks://generic-profiles.activity-type.terrain-ruggedness-index>,
        <bblocks://generic-profiles.activity-type.topographic-position-index>,
        <bblocks://generic-profiles.activity-type.touches>,
        <bblocks://generic-profiles.activity-type.union>,
        <bblocks://generic-profiles.activity-type.within>,
        <bblocks://generic-profiles.concept>,
        <bblocks://generic-profiles.concept.data-discovery-and-access>,
        <bblocks://generic-profiles.concept.point-cloud-processing>,
        <bblocks://generic-profiles.concept.raster-coverage-processing>,
        <bblocks://generic-profiles.concept.terrain-analysis>,
        <bblocks://generic-profiles.concept.vector-geometry-processing>,
        <bblocks://generic-profiles.generic-profile>,
