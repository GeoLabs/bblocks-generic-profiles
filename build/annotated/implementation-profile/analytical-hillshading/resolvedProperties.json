ld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["status"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/status","required":true,"schema_type":"string","enum":["submitted","valid","invalid","superseded","retired"],"sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/status"},{"path":["refinesGenericProfile"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/refinesGenericProfile","jsonld_type":"@id","description":"The single Generic Profile (generic-profiles.generic-profile.*) this Implementation Profile refines.","required":true,"schema_type":"string","format":"uri","const":"https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/analytical-hillshading","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.analytical-hillshading"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/refinesGenericProfile"},{"path":["keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","description":"Table 21 Process.Keywords (E) -- the Generic Profile's keywords plus this operation's own.","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.analytical-hillshading"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","description":"Table 21 Process.Metadata (E, footnote a): the Generic Profile's references (Table 22 `concept`) plus a Table 22 `generic` reference to the Generic Profile.","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.analytical-hillshading"],"ref":"0","effectiveId":"https://w3id.org/ogc/api/processes/metadata"},{"path":["inputs"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/inputs","description":"Keyed by the same input names as the Generic Profile's own `inputs` (Identifier/Title/ Abstract Inherited, not repeated). `schema` is Table 21's Data format (D); `maxOccurs`, when present, Restricts (R, footnote c) the Generic Profile's own value; `keywords` Extend (E) the Generic Profile's; `metadata` Extends (E, footnote a) its superior-profile references.","required":true,"schema_type":"object","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.analytical-hillshading"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/inputs"},{"path":["inputs","dataType"],"id":"http://purl.org/dc/terms/type","jsonld_type":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"What kind of data this input is, as a concept of the generic-profiles.data-type vocabulary (`https://geolabs.github.io/bblocks-generic-profiles/def/data-type/...`). The Generic Profile's, or a narrower one (`skos:broader` chain): e.g. a band-count or a geometry-type restriction.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["inputs","id"],"id":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"This input's own IRI, `<profile id>/inputs/<name>` -- what a lower tier's metadata `href` points at.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"@id"},{"path":["inputs","schema"],"id":"https://w3id.org/ogc/api/processes/schema","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/schema"},{"path":["inputs","minOccurs"],"vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"Restricts the Generic Profile's minimum, down to 0 (the input becomes optional), never above it. A deliberate departure from Table 21 footnote c (\"shall not modify the minimum cardinality\"): a Generic Profile keeps `minOccurs: 1` and lower tiers, down to a real implementation, may make the input optional (e.g. `Gdal_Warp`'s `t_srs`, absent meaning no reprojection).","schema_type":"integer","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/minOccurs"},{"path":["inputs","maxOccurs"],"id":"https://w3id.org/ogc/api/processes/maxOccurs","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/maxOccurs"},{"path":["inputs","keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["inputs","metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"ref":"0","effectiveId":"https://w3id.org/ogc/api/processes/metadata"},{"path":["inputs","metadata","role"],"id":"https://w3id.org/ogc/api/processes/role","jsonld_type":"@id","required":true,"const":"https://geolabs.github.io/bbloc