blicationStatus"},{"path":["isRedacted"],"id":"https://w3id.org/ogc/rim/isRedacted","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","schema_type":"boolean","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/isRedacted"},{"path":["isDeleted"],"id":"https://w3id.org/ogc/rim/isDeleted","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","schema_type":"boolean","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/isDeleted"},{"path":["title"],"id":"http://purl.org/dc/terms/title","schema_type":"string","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["relatedItem"],"id":"https://w3id.org/ogc/rim/relatedItem","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/relatedItem"},{"path":["supersededBy"],"id":"https://w3id.org/ogc/rim/supersededBy","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersededBy"},{"path":["supersedes"],"id":"https://w3id.org/ogc/rim/supersedes","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersedes"},{"path":["hasAction"],"id":"https://w3id.org/ogc/rim/hasAction","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/hasAction"},{"path":["prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","required":true,"schema_type":"string","const":"Band retrieval","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","required":true,"schema_type":"string","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["refinesGenericProfile"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/refinesGenericProfile","jsonld_type":"@id","description":"The single Generic Profile (generic-profiles.generic-profile.*) this Implementation Profile refines.","required":true,"schema_type":"string","format":"uri","const":"https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/band-retrieval","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/refinesGenericProfile"},{"path":["activityType"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/activityType","jsonld_type":"@id","description":"The activity type (generic-profiles.activity-type.*) that holds the meaning of the operation this Implementation Profile binds to formats (decisions D3 and D4). gp:activityType, a sub-property of rim:relatedItem.","required":true,"schema_type":"string","format":"uri","const":"https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/band-retrieval","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/activityType"},{"path":["keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","description":"Table 21 Process.Keywords (E) -- the Generic Profile's keywords plus this operation's own.","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","description":"Table 21 Process.Metadata (E, footnote a): the Generic Profile's references (Table 22 `concept`) plus a Table 22 `generic` reference to the Generic Profile.","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"ref":"1","effectiveId":"https://w3id.org/ogc/api/processes/metadata"},{"path":["inputs"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/inputs","description":"Keyed by the same input names as the Generic Profile's own `inputs` (Identifier/Title/ Abstract Inherited, not repeated). `representation` is Table 21's Data format (D); `maxOccurs`, when present, Restricts (R, footnote c) the Generic Profile's own value; `keywords` Extend (E) the Generic Profile's; `metadata` Extends (E, footnote a) its superior-profile references.","required":true,"schema_type":"object","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/inputs"},{"path":["inputs","dataType"],"id":"http://purl.org/dc/terms/type","jsonld_type":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"What kind of data this input is, as a concept of the bblocks-data-types register (`https://geolabs.github.io/bblocks-data-types/def/data-type/...`). The Generic Profile's, or a narrower one (`skos:broader` chain): e.g. a band-count or a geometry-type restriction.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["inputs","id"],"id":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"This input's own IRI, `<profile id>/inputs/<name>` -- what a lower tier's metadata `href` points at.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"@id"},{"path":["inputs","representation"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/representation","jsonld_type":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"Table 21 Data format (D), by reference (decision D6): one or more representations of the bblocks-data-formats register (`https://w3id.org/geolabs/ospd/data-formats/representation/...`), each realizing a version of this role's dataType, or of a broader one, and pointing to one format. No copied schema: the schema stays at the Implementation (instance level), as served.","schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/representation"},{"path":["inputs","minOccurs"],"vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","description":"Restricts the Generic Profile's minimum, down to 0 (the input becomes optional), never above it. A deliberate departure from Table 21 footnote c (\"shall not modify the minimum cardinality\"): a Generic Profile keeps `minOccurs: 1` and lower tiers, down to a real implementation, may make the input optional (e.g. a target CRS whose absence means no reprojection).","schema_type":"integer","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/minOccurs"},{"path":["inputs","maxOccurs"],"id":"https://w3id.org/ogc/api/processes/maxOccurs","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/maxOccurs"},{"path":["inputs","keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["inputs","metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"ref":"1","effectiveId":"https://w3id.org/ogc/api/processes/metadata"},{"path":["inputs","metadata","role"],"id":"https://w3id.org/ogc/api/processes/role","jsonld_type":"@id","required":true,"const":"https://geolabs.github.io/bblocks-generic-profiles/def/role/generic-input","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/role"},{"path":["outputs"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/outputs","description":"Keyed by the same output names as the Generic Profile's own `outputs`.","required":true,"schema_type":"object","sources":["bblocks://generic-profiles.implementation-profile","bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/outputs"},{"path":["outputs","dataType"],"id":"http://purl.org/dc/terms/type","jsonld_type":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/outputs/","description":"What kind of data this output is, as a concept of the bblocks-data-types register (`https://geolabs.github.io/bblocks-data-types/def/data-type/...`). The Generic Profile's, or a narrower one (`skos:broader` chain): e.g. a band-count or a geometry-type restriction.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["outputs","id"],"id":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/outputs/","description":"This output's own IRI, `<profile id>/outputs/<name>` -- what a lower tier's metadata `href` points at.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"@id"},{"path":["outputs","representation"],"id":"https://geolabs.github.io/bblocks-generic-profiles/def/representation","jsonld_type":"@id","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/outputs/","description":"Table 21 Data format (D), by reference (decision D6): one or more representations of the bblocks-data-formats register (`https://w3id.org/geolabs/ospd/data-formats/representation/...`), each realizing a version of this role's dataType, or of a broader one, and pointing to one format. No copied schema: the schema stays at the Implementation (instance level), as served.","schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/representation"},{"path":["outputs","keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/outputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["outputs","metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/outputs/","required":true,"schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"ref":"1","effectiveId":"https://w3id.org/ogc/api/processes/metadata"},{"path":["outputs","metadata","role"],"id":"https://w3id.org/ogc/api/processes/role","jsonld_type":"@id","required":true,"const":"https://geolabs.github.io/bblocks-generic-profiles/def/role/generic-output","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"https://w3id.org/ogc/api/processes/role"},{"path":["source"],"id":"http://purl.org/dc/terms/source","schema_type":"array","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/source"},{"path":["source","title"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["source","link"],"id":"http://purl.org/dc/terms/references","jsonld_type":"@id","schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.implementation-profile"],"effectiveId":"http://purl.org/dc/terms/references"},{"path":["inputs","product"],"vocab":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/","required":true,"sources":["bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/product"},{"path":["inputs","product","keywords"],"id":"https://w3id.org/ogc/api/processes/keywords","sources":["bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://w3id.org/ogc/api/processes/keywords"},{"path":["inputs","product","metadata"],"id":"https://w3id.org/ogc/api/processes/metadata","sources":["bblocks://generic-profiles.implementation-profile.band-retrieval"],"effectiveId":"https://w3id.org/o