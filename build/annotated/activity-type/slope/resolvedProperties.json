{"defs":{"0":[{"path":["id"],"id":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"@id"}]},"properties":[{"path":["id"],"id":"@id","required":true,"schema_type":"string","format":"uri","const":"https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/slope","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://generic-profiles.activity-type.slope"],"effectiveId":"@id"},{"path":["type"],"id":"@type","description":"rim:RegisterItem, or a sub-register's own term for a sub-class of it.","required":true,"const":["ActivityType","Class"],"sources":["bblocks://ogc.rim.schemas.register-item","bblocks://generic-profiles.activity-type"],"effectiveId":"@type"},{"path":["objectIdentifier"],"id":"https://w3id.org/ogc/rim/objectIdentifier","jsonld_type":"http://www.w3.org/2001/XMLSchema#anyURI","description":"Permanently bound to this item; never redirects.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/objectIdentifier"},{"path":["functionalIdentifier"],"id":"https://w3id.org/ogc/rim/functionalIdentifier","jsonld_type":"http://www.w3.org/2001/XMLSchema#anyURI","description":"Redirectable identifier serving a stable intent (e.g. \"the current version\").","schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/functionalIdentifier"},{"path":["itemClass"],"id":"https://w3id.org/ogc/rim/itemClass","jsonld_type":"@id","description":"The item's one rim:RegisterItemClass (an IRI or an embedded node).","required":true,"const":"https://w3id.org/ogc/rim/activity-type/activityTypeItemClass","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://generic-profiles.activity-type"],"ref":"0","effectiveId":"https://w3id.org/ogc/rim/itemClass"},{"path":["inRegister"],"id":"https://w3id.org/ogc/rim/inRegister","js