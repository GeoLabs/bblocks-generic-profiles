ttps://w3id.org/ogc/rim/relatedItem","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/relatedItem"},{"path":["supersededBy"],"id":"https://w3id.org/ogc/rim/supersededBy","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersededBy"},{"path":["supersedes"],"id":"https://w3id.org/ogc/rim/supersedes","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersedes"},{"path":["hasAction"],"id":"https://w3id.org/ogc/rim/hasAction","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/hasAction"},{"path":["usedEntityType"],"id":"https://w3id.org/ogc/rim/activity-type/usedEntityType","jsonld_type":"@id","description":"A type of prov:Entity that activities of this type use (prov:used) \u2014 for example a type of input dataset.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/usedEntityType"},{"path":["generatedEntityType"],"id":"https://w3id.org/ogc/rim/activity-type/generatedEntityType","jsonld_type":"@id","description":"A type of prov:Entity that activities of this type generate (prov:generated) \u2014 for example a type of output product.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/generatedEntityType"},{"path":["associatedAgentType"],"id":"https://w3id.org/ogc/rim/activity-type/associatedAgentType","jsonld_type":"@id","description":"A type of prov:Agent (for example prov:Person, prov:SoftwareAgent, or a narrower role-bearing type) that activities of this type are associated with (prov:wasAssociatedWith).","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/associatedAgentType"},{"path":["informedByActivityType"],"id":"https://w3id.org/ogc/rim/activity-type/informedByActivityType","jsonld_type":"@id","description":"A type of acttype:ActivityType whose instances typically inform activities of this type (prov:wasInformedBy) \u2014 for example an upstream preparation activity type.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/informedByActivityType"},{"path":["prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","required":true,"schema_type":"string","const":"Slope","sources":["bblocks://generic-profiles.activity-type","bblocks://generic-profiles.activity-type.slope"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["altLabel"],"id":"http://www.w3.org/2004/02/skos/core#altLabel","description":"Other names of the operation, e.g. its SQL/MM function name.","schema_type":"array","sources":["bblocks://generic-profiles.activity-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#altLabel"},{"path":["definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"What the operation does. No tool, format or deployment.","required":true,"schema_type":"string","sources":["bblocks://generic-profiles.activity-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["subClassOf"],"id":"http://www.w3.org/2000/01/rdf-schema#subClassOf","jsonld_type":"@id","description":"Every activity type of this register is a geoprocessing activity type, with at least one GeoSPARQL spatial used or generated entity type (geoproc shapes).","required":true,"const":"https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType","sources":["bblocks://generic-profiles.activity-type","bblocks://generic-profiles.activity-type.slope"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#subClassOf"},{"path":["source"],"id":"http://purl.org/dc/terms/source","schema_type":"array","sources":["bblocks://generic-profiles.activity-type"],"effectiveId":"http://purl.org/dc/terms/source"},{"path":["source","title"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://generic-profiles.activity-type"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["source","link"],"id":"http://purl.org/dc/terms/references","jsonld_type":"@id","schema_type":"string","format":"uri","sources":["bblocks://generic-profiles.activity-type"],"effectiveId":"http://purl.org/dc/terms/references"}]}