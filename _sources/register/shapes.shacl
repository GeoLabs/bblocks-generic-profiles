@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Constrained-profile shapes. Every gp:ProcessConcept / gp:GenericProfile /
# gp:ImplementationProfile is a rim:RegisterItem (ontology.ttl), so the base
# rim:RegisterItemShape -- object identifier, item class, validity and
# publication status -- continues to apply through the ontology closure.
# These shapes only pin, per tier, which item class and which register the
# item belongs to, and that the tier-to-tier link is present, in both
# directions (item -> class, class -> items), as the Registered Item
# Model's own activity-type profile does.
#
# Cross-item references (skos:broader, gp:refinesGenericProfile) are checked
# as IRIs, not with sh:class: each entry is validated on its own, so the
# referenced item's type is not in the data graph.

gp:ProcessConceptShape a sh:NodeShape ;
    sh:targetClass gp:ProcessConcept ;
    sh:property [ sh:path rim:itemClass ;  sh:hasValue gpic:process-concept ;
                  sh:message "A Process Concept's rim:itemClass must be gpic:process-concept." ] ;
    sh:property [ sh:path rim:inRegister ; sh:hasValue gp:register ;
                  sh:message "A Process Concept must be in gp:register." ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .

gp:GenericProfileShape a sh:NodeShape ;
    sh:targetClass gp:GenericProfile ;
    sh:property [ sh:path rim:itemClass ;  sh:hasValue gpic:generic-profile ;
                  sh:message "A Generic Profile's rim:itemClass must be gpic:generic-profile." ] ;
    sh:property [ sh:path rim:inRegister ; sh:hasValue gp:register ;
                  sh:message "A Generic Profile must be in gp:register." ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] ;
    sh:property [ sh:path skos:broader ;   sh:nodeKind sh:IRI ; sh:minCount 1 ;
                  sh:message "A Generic Profile must name at least one Process Concept (skos:broader)." ] .

gp:ImplementationProfileShape a sh:NodeShape ;
    sh:targetClass gp:ImplementationProfile ;
    sh:property [ sh:path rim:itemClass ;  sh:hasValue gpic:implementation-profile ;
                  sh:message "An Implementation Profile's rim:itemClass must be gpic:implementation-profile." ] ;
    sh:property [ sh:path rim:inRegister ; sh:hasValue gp:register ;
                  sh:message "An Implementation Profile must be in gp:register." ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] ;
    sh:property [ sh:path gp:refinesGenericProfile ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An Implementation Profile must refine exactly one Generic Profile." ] ;
    # Decision D4: exactly one activity type of this register, which holds the meaning of the
    # operation. Checked as an IRI under this register's activity-type namespace, as the other
    # cross-item links: the activity type is not in the profile's data graph.
    sh:property [ sh:path gp:activityType ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^https://geolabs\\.github\\.io/bblocks-generic-profiles/def/activity-type/[a-z0-9-]+$" ;
                  sh:message "An Implementation Profile must point to exactly one activity type of this register (activityType)." ] .

# Class -> items: anything claiming one of these item classes must be of the matching type.

gp:ProcessConceptItemClassShape a sh:NodeShape ;
    sh:targetNode gpic:process-concept ;
    sh:property [ sh:path [ sh:inversePath rim:itemClass ] ; sh:class gp:ProcessConcept ;
                  sh:message "Every item of item class gpic:process-concept must be a gp:ProcessConcept." ] .

gp:GenericProfileItemClassShape a sh:NodeShape ;
    sh:targetNode gpic:generic-profile ;
    sh:property [ sh:path [ sh:inversePath rim:itemClass ] ; sh:class gp:GenericProfile ;
                  sh:message "Every item of item class gpic:generic-profile must be a gp:GenericProfile." ] .

gp:ImplementationProfileItemClassShape a sh:NodeShape ;
    sh:targetNode gpic:implementation-profile ;
    sh:property [ sh:path [ sh:inversePath rim:itemClass ] ; sh:class gp:ImplementationProfile ;
                  sh:message "Every item of item class gpic:implementation-profile must be a gp:ImplementationProfile." ] .

# Every entry records its entry into the register: at least one rim:additionAction, with a proposer.
gp:AdditionProposalShape a sh:NodeShape ;
    sh:targetClass gp:ProcessConcept , gp:GenericProfile , gp:ImplementationProfile ;
    sh:property [
        sh:path rim:hasAction ;
        sh:qualifiedValueShape [
            sh:property [ sh:path rim:actionType ; sh:hasValue rim:additionAction ] ,
                        [ sh:path rim:proposer ;   sh:minCount 1 ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:minCount 1 ;
        sh:message "An entry must record its addition: a rim:hasAction of type rim:additionAction with a rim:proposer."
    ] .

# Every input and output of a Generic or Implementation Profile names its kind of data with
# `dataType` (dct:type). It must be a dt:DataType concept of the bblocks-data-types register. An
# input or output is the value of a role under gp:inputs / gp:outputs, and the role is a free name,
# so a SPARQL target is the way to reach it. That target is SHACL-AF: pyshacl honours it in advanced
# mode, as bblocks-postprocess runs it, and ignores it otherwise. sh:targetSubjectsOf dct:type is too
# wide: at tier 4 the `type: application/json` of a processDescription link maps to dct:type as well.
# It is also too narrow: it never reaches an input with no dataType, which this target does.
#
# This covers tiers 2 and 3 only. Tier 4 inputs and outputs sit under proc:inputs / proc:outputs,
# where this target selects nothing, so a dataType at tier 4 is not checked here. To be handled in
# phase 4 of the tier separation, when tier 4 carries dataType.
#
# sh:class needs the concept's rdf:type, which reaches this block through data-types.vocabulary:
# its `resources` give each data type's ontology by absolute URL, and they load. Its `shaclClosures`
# list the same files by relative path, and those 53 sources fail at import, as non-blocking
# messages in the build report. tests/input-datatype-not-a-concept-fail.ttl and its control
# tests/link-media-type-in-dct-type.ttl show that the check works with what loads.
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt:  <https://geolabs.github.io/bblocks-data-types/def/> .

gp:DataTypeReferenceShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?profile <https://geolabs.github.io/bblocks-generic-profiles/def/inputs> | <https://geolabs.github.io/bblocks-generic-profiles/def/outputs> ?roles .
                ?roles ?role ?this .
            }
        """
    ] ;
    sh:property [ sh:path dct:type ; sh:class dt:DataType ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An input or output's dataType must be a dt:DataType concept of the bblocks-data-types register." ] .

# Decision D6: an input or output of a Generic or Implementation Profile carries no copied schema,
# and an Implementation Profile names its format by representation. Same target as
# gp:DataTypeReferenceShape: the inputs and outputs of tiers 2 and 3 (tier 4 sits under
# proc:inputs / proc:outputs, where `schema` stays).
#
# - proc:schema: none. A Generic Profile carries no format; an Implementation Profile carries
#   representations instead.
# - gp:representation: a df:Representation of the data-formats register, whose type reaches this
#   block through data-formats.vocabulary, as the data types do through data-types.vocabulary.
# - the representation realizes a version of the role's dataType, or of a broader data type
#   (skos:broader*): a GeoTIFF raster may carry a single-band raster, not a geometry.
#
# tests/representation-*-fail.ttl, tests/role-with-schema-fail.ttl and their control
# tests/representation-control.ttl show each constraint rejecting an otherwise valid item.
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix df:   <https://w3id.org/geolabs-ospd/data-formats/> .

gp:RepresentationReferenceShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?profile <https://geolabs.github.io/bblocks-generic-profiles/def/inputs> | <https://geolabs.github.io/bblocks-generic-profiles/def/outputs> ?roles .
                ?roles ?role ?this .
            }
        """
    ] ;
    sh:property [ sh:path proc:schema ; sh:maxCount 0 ;
                  sh:message "An input or output of a Generic or Implementation Profile carries no schema: a format is named by representation, at tier 3 only." ] ;
    sh:property [ sh:path gp:representation ; sh:nodeKind sh:IRI ; sh:class df:Representation ;
                  sh:message "A representation must be a df:Representation of the bblocks-data-formats register." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A representation must realize a version of the role's dataType, or of a broader data type." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this <https://geolabs.github.io/bblocks-generic-profiles/def/representation> ?value .
                $this <http://purl.org/dc/terms/type> ?dataType .
                FILTER NOT EXISTS {
                    ?value <https://w3id.org/ogc/rim/realizes> ?version .
                    ?version <https://w3id.org/ogc/rim/versionOf> ?concept .
                    ?dataType <http://www.w3.org/2004/02/skos/core#broader>* ?concept .
                }
            }
        """
    ] .
