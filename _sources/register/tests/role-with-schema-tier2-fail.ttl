# Must fail: a Generic Profile role with a schema. Only gp:RepresentationReferenceShape (proc:schema) can reject it.
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dt:   <https://geolabs.github.io/bblocks-data-types/def/data-type/> .
@prefix rep:  <https://w3id.org/geolabs-ospd/data-formats/representation/> .
@prefix role: <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/inputs/> .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2> a gp:GenericProfile ;
    skos:prefLabel "Fixture" ;
    skos:broader <https://geolabs.github.io/bblocks-generic-profiles/def/concept/raster-coverage-processing> ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2"^^xsd:anyURI ;
    rim:itemClass gpic:generic-profile ;
    rim:inRegister gp:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2/actions/addition> ;
    gp:inputs [ role:geometry <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2/inputs/geometry> ] .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer gp:geolabs ;
    rim:appliesTo <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2> ;
    prov:startedAtTime "2026-11-09T00:00:00Z"^^xsd:dateTime .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/fixture-role-with-schema-tier2/inputs/geometry> dct:title "geometry" ; dct:type dt:geometry ; proc:schema [ <https://w3id.org/ogc/api/schema/contentMediaType> "text/xml" ] .
