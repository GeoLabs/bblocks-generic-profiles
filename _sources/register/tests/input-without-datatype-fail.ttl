# Must fail: an input with no dataType. The former target, sh:targetSubjectsOf dct:type, never
# reached such a node. Turtle, so that only SHACL can catch it, not the JSON Schema.
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix role: <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/inputs/> .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing> a gp:GenericProfile ;
    skos:prefLabel "Fixture" ;
    skos:broader <https://geolabs.github.io/bblocks-generic-profiles/def/concept/vector-geometry-processing> ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing"^^xsd:anyURI ;
    rim:itemClass gpic:generic-profile ;
    rim:inRegister gp:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing/actions/addition> ;
    gp:inputs [ role:geometry <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing/inputs/geometry> ] .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer gp:geolabs ;
    rim:appliesTo <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing> ;
    prov:startedAtTime "2026-11-06T00:00:00Z"^^xsd:dateTime .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-missing/inputs/geometry> dct:title "Geometry" .
