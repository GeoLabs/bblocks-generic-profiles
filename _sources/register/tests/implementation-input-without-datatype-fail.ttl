# Must fail: a tier 3 role, under the implementation-profile role namespace, with no dataType.
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix role: <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/inputs/> .

<https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype> a gp:ImplementationProfile ;
    skos:prefLabel "Fixture" ;
    gp:refinesGenericProfile <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/geometry-measure> ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype"^^xsd:anyURI ;
    rim:itemClass gpic:implementation-profile ;
    rim:inRegister gp:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype/actions/addition> ;
    gp:inputs [ role:result <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype/inputs/result> ] .

<https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer gp:geolabs ;
    rim:appliesTo <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype> ;
    prov:startedAtTime "2026-11-06T00:00:00Z"^^xsd:dateTime .

<https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/input-without-datatype/inputs/result> dct:title "Result" .
