# Must fail: otherwise valid, but the dataType IRI is not a dt:DataType concept. Only
# gp:DataTypeReferenceShape can reject it.
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix role: <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/inputs/> .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept> a gp:GenericProfile ;
    skos:prefLabel "Fixture" ;
    skos:broader <https://geolabs.github.io/bblocks-generic-profiles/def/concept/vector-geometry-processing> ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept"^^xsd:anyURI ;
    rim:itemClass gpic:generic-profile ;
    rim:inRegister gp:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept/actions/addition> ;
    gp:inputs [ role:geometry <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept/inputs/geometry> ] .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer gp:geolabs ;
    rim:appliesTo <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept> ;
    prov:startedAtTime "2026-11-06T00:00:00Z"^^xsd:dateTime .

<https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/datatype-not-a-concept/inputs/geometry> dct:title "Geometry" ; dct:type <https://geolabs.github.io/bblocks-data-types/def/data-type/not-a-data-type> .
