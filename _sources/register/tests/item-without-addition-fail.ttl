# Must fail: complete in every respect (item class, register, validity, publication, refined
# Generic Profile) except that it records no addition -- only gp:AdditionProposalShape can reject it.
@prefix gp:   <https://geolabs.github.io/bblocks-generic-profiles/def/> .
@prefix gpic: <https://geolabs.github.io/bblocks-generic-profiles/def/item-class/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/never-added>
    a gp:ImplementationProfile ;
    skos:prefLabel "Never added" ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/never-added"^^xsd:anyURI ;
    rim:itemClass gpic:implementation-profile ;
    rim:inRegister gp:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    gp:refinesGenericProfile <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/binary-spatial-predicate> .
