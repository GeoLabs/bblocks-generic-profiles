{
  "@context": {
    "@version": 1.1,
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dct": "http://purl.org/dc/terms/",
    "proc": "https://w3id.org/ogc/api/processes/",
    "gp": "https://w3id.org/geolabs/ospd/generic-profiles/",
    "id": "@id",
    "type": "@type",
    "ImplementationProfile": "gp:ImplementationProfile",
    "prefLabel": "skos:prefLabel",
    "definition": "skos:definition",
    "inScheme": {
      "@id": "skos:inScheme",
      "@type": "@id"
    },
    "refinesGenericProfile": {
      "@id": "gp:refinesGenericProfile",
      "@type": "@id"
    },
    "activityType": {
      "@id": "gp:activityType",
      "@type": "@id"
    },
    "keywords": "proc:keywords",
    "metadata": {
      "@id": "proc:metadata",
      "@context": {
        "title": "dct:title",
        "role": {
          "@id": "proc:role",
          "@type": "@id"
        },
        "href": {
          "@id": "proc:href",
          "@type": "@id"
        }
      }
    },
    "source": "dct:source",
    "title": "dct:title",
    "link": {
      "@id": "dct:references",
      "@type": "@id"
    },
    "inputs": {
      "@id": "gp:inputs",
      "@context": {
        "@vocab": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/inputs/",
        "representation": {
          "@id": "gp:representation",
          "@type": "@id"
        },
        "maxOccurs": "proc:maxOccurs",
        "keywords": "proc:keywords",
        "dataType": {
          "@id": "dct:type",
          "@type": "@id"
        },
        "metadata": {
          "@id": "proc:metadata",
          "@context": {
            "title": "dct:title",
            "role": {
              "@id": "proc:role",
              "@type": "@id"
            },
            "href": {
              "@id": "proc:href",
              "@type": "@id"
            }
          }
        }
      }
    },
    "outputs": {
      "@id": "gp:outputs",
      "@context": {
        "@vocab": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/outputs/",
        "representation": {
          "@id": "gp:representation",
          "@type": "@id"
        },
        "keywords": "proc:keywords",
        "dataType": {
          "@id": "dct:type",
          "@type": "@id"
        },
        "metadata": {
          "@id": "proc:metadata",
          "@context": {
            "title": "dct:title",
            "role": {
              "@id": "proc:role",
              "@type": "@id"
            },
            "href": {
              "@id": "proc:href",
              "@type": "@id"
            }
          }
        }
      }
    },
    "sameAs": {
      "@id": "http://www.w3.org/2002/07/owl#sameAs",
      "@type": "@id"
    },
    "affectedProperty": {
      "@id": "https://w3id.org/ogc/rim/affectedProperty",
      "@type": "@id"
    }
  }
}
